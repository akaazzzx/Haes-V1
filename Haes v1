        rem.AutoButtonColor=false Instance.new("UICorner",rem).CornerRadius=UDim.new(0,4)
        rem.MouseButton1Click:Connect(function()
            C.blacklist[uid] = nil
            updatePlayerUI()
        end)
    end
end

