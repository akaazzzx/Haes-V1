local CHARSET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
local function lcg(s) return (s*1664525+1013904223)%4294967296 end
local function genKeySet(prefix,seed,n)
    local set={} local s=seed
    for _=1,n do
        s=lcg(s) local k=prefix.."-"
        for _=1,8 do s=lcg(s) k=k..CHARSET:sub(s%32+1,s%32+1) end
        set[k]=true
    end
    return set
end
