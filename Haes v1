local function getTarget(team,wall,hp,knock,part,dist,fov,noFov)
    local myC=LP.Character if not myC then return nil end
    local myR=myC:FindFirstChild("HumanoidRootPart") if not myR then return nil end
    local cx=Camera.ViewportSize.X/2 local cy=Camera.ViewportSize.Y/2
    local best,bestD=nil, noFov and math.huge or fov
    
    for _,plr in ipairs(PLRS:GetPlayers()) do
        if plr==LP or not plr.Character then continue end
        if isWhitelisted(plr) then continue end
        
        local isBl = isBlacklisted(plr)
        if team and isTeam(plr) and not isBl then continue end
        
        local ch=plr.Character
        local tp=ch:FindFirstChild(part) or ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if not tp or not hum then continue end
        if hp and hum.Health<=0 then continue end
        if knock and isKnockedOrDead(ch) then continue end
        if(tp.Position-myR.Position).Magnitude>dist then continue end
        
        local aimPos=C.aaPred and predictPos(tp) or tp.Position
        local sp,on2,depth=w2v(aimPos)
        if not on2 or depth<0 then continue end
        
        local sd=(sp-Vector2.new(cx,cy)).Magnitude
        if sd<bestD then
            if wall and not rayWall(ch,tp) then continue end
            best={plr=plr,part=tp,sp=sp} bestD=sd
        end
    end
    return best
end

