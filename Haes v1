local function updateLcInfoCard(r)
    if not r or not r.valid then return end
    local tierColors={PERMANENT=Color3.fromRGB(50,200,100),MONTHLY=Color3.fromRGB(50,150,255),WEEKLY=Color3.fromRGB(200,160,50),DAILY=Color3.fromRGB(200,100,50)}
    lcTierLbl.Text="Tier: "..(r.tier or "—") lcTierLbl.TextColor3=tierColors[r.tier] or TCOL
    lcTimeLbl.Text=r.remaining==-1 and "Remaining: ∞ (Permanent)" or("Remaining: "..r.label)
    lcPlayerLbl.Text="Bound: "..LP.Name.." ("..LP.UserId..")"
end

local function startExpiryMonitor(r)
    if not r or not r.valid or r.remaining==-1 then return end
    task.spawn(function()
        local thresholds={{secs=86400,msg="24 hours remaining",urgent=false},{secs=3600,msg="1 hour remaining",urgent=true},{secs=600,msg="10 minutes remaining",urgent=true}}
        local shown={}
        while true do
            task.wait(30)
            local d=readJson(LICENCE_FILE) if not d or not d.key then return end
            local nr=validateKey(d.key)
            if not nr.valid then
                main.Visible=false mainShown=false licenceScreen.Visible=true return
            end
            lcTimeLbl.Text="Remaining: "..nr.label
            for _,th in ipairs(thresholds) do
                if nr.remaining<=th.secs and not shown[th.secs] then shown[th.secs]=true end
            end
        end
    end)
end

local function launchMain(r, skipAnim)
    if mainShown then return end 
    mainShown=true 
    currentKeyResult=r
    if skipAnim then
        licenceScreen.Visible = false
        main.Visible = true
        updateLcInfoCard(r)
        startExpiryMonitor(r)
        task.defer(function() switchTab("Combat",tabBtns[1]) end)
        return
    end
    task.spawn(function()
        TWEEN:Create(licenceScreen,TweenInfo.new(0.18,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{BackgroundTransparency=1}):Play()
        task.wait(0.18) licenceScreen.Visible=false
        main.Visible=true updateLcInfoCard(r) startExpiryMonitor(r)
        task.defer(function() switchTab("Combat",tabBtns[1]) end)
    end)
end

