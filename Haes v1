local function raycastCenter(maxDist)
    local origin = Camera.CFrame.Position
    local dir = Camera.CFrame.LookVector * (maxDist or 2000)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    local filter = {} if LP.Character then table.insert(filter, LP.Character) end
    rp.FilterDescendantsInstances = filter
    local result = WS:Raycast(origin, dir, rp)
    return result and result.Instance or nil
end

local tbLastFire=0
local function findTriggerTarget()
    local mt = Mouse.Target
    if mt then
        local tc = mt:FindFirstAncestorOfClass("Model")
        while tc do
            local pl = PLRS:GetPlayerFromCharacter(tc)
            if pl then return tc, pl end
            tc = tc:FindFirstAncestorOfClass("Model")
        end
    end
    local hit = raycastCenter(2000)
    if hit then
        local tc = hit:FindFirstAncestorOfClass("Model")
        while tc do
            local pl = PLRS:GetPlayerFromCharacter(tc)
            if pl then return tc, pl end
            tc = tc:FindFirstAncestorOfClass("Model")
        end
    end
    local cx,cy = Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2
    local center = Vector2.new(cx, cy)
    local tol = math.max(20, 18 * C.tbMult)
    local best, bestD, bestPl = nil, tol, nil
    for _,plr in ipairs(PLRS:GetPlayers()) do
        if plr == LP or not plr.Character then continue end
        if isWhitelisted(plr) then continue end
        local isBl = isBlacklisted(plr)
        if C.tbTeam and isTeam(plr) and not isBl then continue end
        local ch = plr.Character
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        if C.tbKnock and isKnockedOrDead(ch) then continue end
        local head = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
        if not head then continue end
        local sp, on = w2v(head.Position)
        if not on then continue end
        local d = (sp - center).Magnitude
        if d < bestD then best, bestD, bestPl = ch, d, plr end
    end
    return best, bestPl
end

local function tickTrigger()
    if not isActive("tb") then return end
    local char=LP.Character if not char then return end
    if C.tbKnifeCheck then
        local tool=char:FindFirstChildWhichIsA("Tool")
        if tool and isMelee(tool) then return end
    end
    local targetChar, plr = findTriggerTarget()
    if not targetChar or not plr then return end
    if plr == LP or isWhitelisted(plr) then return end
    local isBl = isBlacklisted(plr)
    if C.tbTeam and isTeam(plr) and not isBl then return end
    local hum = targetChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if C.tbKnock and isKnockedOrDead(targetChar) then return end
    if C.tbWall then
        local tp = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
        if tp and not rayWall(targetChar, tp) then return end
    end
    local now = tick()
    local cycle = (C.tbDelay + C.tbRel) / 1000
    if now - tbLastFire < cycle then return end
    tbLastFire = now
    task.delay(C.tbDelay / 1000, function() doFire() end)
end

local mtbLastFire=0
local function tickMagneticTB(dt)
    if not C.mtbOn then return end
    local char=LP.Character if not char then return end
    if C.mtbKnifeCheck then
        local tool=char:FindFirstChildWhichIsA("Tool")
        if tool and isMelee(tool) then return end
    end
    
    local t=getTarget(C.mtbTeam, C.mtbWall, true, C.mtbKnock, "Head", 1500, C.mtbRadius)
    if not t then return end
    
    local aimPos = C.aaPred and predictPos(t.part, C.aaPredScale, C.aaBulletSpd) or t.part.Position
    local goalCF = CFrame.lookAt(Camera.CFrame.Position, aimPos)
    local alpha = 1 - (1 - math.clamp(C.mtbStrength*0.05, 0.01, 0.8))^(dt*60)
    Camera.CFrame = Camera.CFrame:Lerp(goalCF, alpha)
    
    local sp, on = w2v(aimPos)
    if not on then return end
    local cx, cy = Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2
    if (sp - Vector2.new(cx, cy)).Magnitude < 12 then
        local now = tick()
        local cycle = (C.mtbDelay + C.mtbRel) / 1000
        if now - mtbLastFire < cycle then return end
        mtbLastFire = now
        task.delay(C.mtbDelay / 1000, function() doFire() end)
    end
end

