local function updatePlayerUI()
    for _,c in ipairs(availFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local filter = searchBox.Text:lower()
    local sortedPlrs = {}
    for _,p in ipairs(PLRS:GetPlayers()) do if p ~= LP then table.insert(sortedPlrs, p) end end
    table.sort(sortedPlrs, function(a,b) return a.Name < b.Name end)

    for _,p in ipairs(sortedPlrs) do
        local nameMatch = p.Name:lower():find(filter) or (p.DisplayName and p.DisplayName:lower():find(filter))
        if nameMatch or filter == "" then
            local isWL = isWhitelisted(p)
            local isBL = isBlacklisted(p)
            local row = Instance.new("Frame", availFrame)
            row.Size = UDim2.new(1,-4,0,24) row.BackgroundColor3=BG4 row.BorderSizePixel=0 row.ZIndex=4
            Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
            
            local nameStr = p.DisplayName ~= p.Name and (p.DisplayName.." (@"..p.Name..")") or p.Name
            local txt = Instance.new("TextLabel", row)
            txt.Size=UDim2.new(1,-100,1,0) txt.Position=UDim2.new(0,8,0,0)
            txt.BackgroundTransparency=1 txt.Text=nameStr txt.TextColor3=TCOL
            txt.Font=Enum.Font.Gotham txt.TextSize=10 txt.TextXAlignment=Enum.TextXAlignment.Left txt.ZIndex=5
            txt.TextTruncate=Enum.TextTruncate.AtEnd
            
            local btnWL = Instance.new("TextButton", row)
            btnWL.Size=UDim2.new(0,45,0,17) btnWL.Position=UDim2.new(1,-95,0.5,-8.5)
            btnWL.BackgroundColor3=isWL and Color3.fromRGB(40,180,90) or BG3
            btnWL.BorderSizePixel=0 btnWL.Text=isWL and "✓ WL" or "+ WL"
            btnWL.TextColor3=isWL and Color3.new(1,1,1) or TDIM btnWL.Font=Enum.Font.GothamSemibold btnWL.TextSize=8 btnWL.ZIndex=5
            btnWL.AutoButtonColor=false Instance.new("UICorner",btnWL).CornerRadius=UDim.new(0,4)
            if not isWL then Instance.new("UIStroke",btnWL).Color=BORDER end
            btnWL.MouseButton1Click:Connect(function()
                if isWL then
                    C.whitelist[tostring(p.UserId)] = nil
                    C.whitelist[p.Name] = nil
                else
                    C.whitelist[tostring(p.UserId)] = p.Name
                    C.blacklist[tostring(p.UserId)] = nil
                    C.blacklist[p.Name] = nil
                end
                updatePlayerUI()
            end)
            
            local btnBL = Instance.new("TextButton", row)
            btnBL.Size=UDim2.new(0,45,0,17) btnBL.Position=UDim2.new(1,-45,0.5,-8.5)
            btnBL.BackgroundColor3=isBL and Color3.fromRGB(220,50,50) or BG3
            btnBL.BorderSizePixel=0 btnBL.Text=isBL and "✓ BL" or "+ BL"
            btnBL.TextColor3=isBL and Color3.new(1,1,1) or TDIM btnBL.Font=Enum.Font.GothamSemibold btnBL.TextSize=8 btnBL.ZIndex=5
            btnBL.AutoButtonColor=false Instance.new("UICorner",btnBL).CornerRadius=UDim.new(0,4)
            if not isBL then Instance.new("UIStroke",btnBL).Color=BORDER end
            btnBL.MouseButton1Click:Connect(function()
                if isBL then
                    C.blacklist[tostring(p.UserId)] = nil
                    C.blacklist[p.Name] = nil
                else
                    C.blacklist[tostring(p.UserId)] = p.Name
                    C.whitelist[tostring(p.UserId)] = nil
                    C.whitelist[p.Name] = nil
                end
                updatePlayerUI()
            end)
        end
    end

    for _,c in ipairs(wlFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    for uid, name in pairs(C.whitelist) do
        local row = Instance.new("Frame", wlFrame)
        row.Size=UDim2.new(1,-4,0,22) row.BackgroundColor3=BG4 row.BorderSizePixel=0 row.ZIndex=4
        Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
        local txt = Instance.new("TextLabel", row)
        txt.Size=UDim2.new(1,-24,1,0) txt.Position=UDim2.new(0,8,0,0)
        txt.BackgroundTransparency=1 txt.Text="  "..tostring(name) txt.TextColor3=Color3.fromRGB(60,255,110)
        txt.Font=Enum.Font.GothamSemibold txt.TextSize=10 txt.TextXAlignment=Enum.TextXAlignment.Left txt.ZIndex=5
        local rem = Instance.new("TextButton", row)
        rem.Size=UDim2.new(0,20,0,17) rem.Position=UDim2.new(1,-22,0.5,-8.5)
        rem.BackgroundColor3=Color3.fromRGB(180,40,40) rem.BorderSizePixel=0 rem.Text="X"
        rem.TextColor3=Color3.new(1,1,1) rem.Font=Enum.Font.GothamBold rem.TextSize=9 rem.ZIndex=5
        rem.AutoButtonColor=false Instance.new("UICorner",rem).CornerRadius=UDim.new(0,4)
