local function getDeviceID()
    if type(gethwid) == "function" then
        local ok, hwid = pcall(gethwid)
        if ok and hwid then return "HWID_" .. tostring(hwid) end
    end
    if type(get_hwid) == "function" then
        local ok, hwid = pcall(get_hwid)
        if ok and hwid then return "HWID_" .. tostring(hwid) end
    end
    if type(syn) == "table" and type(syn.get_hwid) == "function" then
        local ok, hwid = pcall(syn.get_hwid)
        if ok and hwid then return "HWID_" .. tostring(hwid) end
    end
    
    local deviceFile = "haes_device_id.txt"
    if type(readfile) == "function" then
        local ok, id = pcall(readfile, deviceFile)
        if ok and id and #id > 5 then return "FILE_" .. id end
    end
    
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local newId = ""
    for i = 1, 32 do
        local r = math.random(1, #chars)
        newId = newId .. chars:sub(r, r)
    end
    if type(writefile) == "function" then
        pcall(writefile, deviceFile, newId)
    end
    return "FILE_" .. newId
end

local function readJson(file)
    if type(readfile)~="function" then return nil end
    local ok,raw=pcall(readfile,file) if not ok or not raw or raw=="" then return nil end
    local d pcall(function() d=HS:JSONDecode(raw) end) return d
end
local function writeJson(file,data)
    if type(writefile)~="function" then return end
    pcall(writefile,file,HS:JSONEncode(data))
end

local function getActivation(key)
    local d=readJson(LICENCE_FILE) 
    if not d or d.key~=key then return nil end
    
    if d.hwid and string.find(d.hwid, "|") then
        if d.userId and tostring(d.userId) == tostring(LP.UserId) then
            d.hwid = getDeviceID()
            writeJson(LICENCE_FILE, d)
            return d.activated
        else
            return "HWID_MISMATCH"
        end
    end
    
    local currentHWID = getDeviceID()
    if d.hwid and d.hwid ~= currentHWID then return "HWID_MISMATCH" end
    return d.activated
end

local function setActivation(key)
    writeJson(LICENCE_FILE,{
        key=key,
        activated=os.time(),
        hwid=getDeviceID(),
        player=LP.Name,
        userId=LP.UserId
    })
end

local function validateKey(key)
    key=key:upper():gsub("%s+","")
    if PERM_KEYS[key] then
        local act=getActivation(key)
        if act=="HWID_MISMATCH" then return{valid=false,tier=nil,label="LICENSE BOUND TO ANOTHER DEVICE"} end
        if not act then setActivation(key) end
        return{valid=true,tier="PERMANENT",label="∞",remaining=-1}
    end
    local function tc(set,dur,tier)
        if not set[key] then return nil end
        local act=getActivation(key)
        if act=="HWID_MISMATCH" then return{valid=false,tier=tier,label="LICENSE BOUND TO ANOTHER DEVICE"} end
        if not act then setActivation(key) act=os.time() end
        local rem=act+dur-os.time()
        if rem<=0 then return{valid=false,tier=tier,label="EXPIRED",remaining=0} end
        local d=math.floor(rem/86400) local h=math.floor((rem%86400)/3600) local m=math.floor((rem%3600)/60)
        local label=d>0 and(d.."d "..h.."h") or(h>0 and(h.."h "..m.."m")or(m.."m"))
        return{valid=true,tier=tier,label=label,remaining=rem}
    end
    return tc(MNTH_KEYS,30*86400,"MONTHLY") or tc(WEEK_KEYS,7*86400,"WEEKLY")
        or tc(DAY1_KEYS,86400,"DAILY") or{valid=false,tier=nil,label="INVALID KEY"}
end

