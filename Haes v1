local function serializeConfig()
    local c = {}
    for k,v in pairs(C) do
        if type(v) == "number" or type(v) == "boolean" or type(v) == "string" then
            c[k] = v
        elseif k == "accent" or k == "aaFovCol" then
            c[k] = {v.R, v.G, v.B}
        elseif k == "whitelist" or k == "blacklist" or k == "_state" or k == "binds" then
            c[k] = {}
            for sk, sv in pairs(v) do 
                if type(sv) == "table" then
                    c[k][sk] = {}
                    for ssk, ssv in pairs(sv) do c[k][sk][ssk] = ssv end
                else
                    c[k][sk] = sv 
                end
            end
        end
    end
    return c
end

