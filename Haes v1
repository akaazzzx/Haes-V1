local function isTeam(p)
    if not p or not p.Character then return false end
    if LP.Team ~= nil and p.Team ~= nil and LP.Team == p.Team then return true end
    
    local attrs = {"Team", "TeamId", "TeamName", "Crew", "Faction"}
    for _, attr in ipairs(attrs) do
        local a = LP:GetAttribute(attr)
        local b = p:GetAttribute(attr)
        if a ~= nil and b ~= nil and tostring(a) == tostring(b) then return true end
        local ca = LP.Character:GetAttribute(attr)
        local cb = p.Character:GetAttribute(attr)
        if ca ~= nil and cb ~= nil and tostring(ca) == tostring(cb) then return true end
    end
    
    local myCrew = LP:FindFirstChild("Crew")
    local theirCrew = p:FindFirstChild("Crew")
    if myCrew and theirCrew and myCrew.Value == theirCrew.Value then return true end
    
    local myCharCrew = LP.Character:FindFirstChild("Crew")
    local theirCharCrew = p.Character:FindFirstChild("Crew")
    if myCharCrew and theirCharCrew and myCharCrew.Value == theirCharCrew.Value then return true end
    
    return false
end

local function rayWall(char, part)
    if not char or not part then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    local filter = {}
    if LP.Character then table.insert(filter, LP.Character) end
    rp.FilterDescendantsInstances = filter
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local result = WS:Raycast(origin, dir, rp)
    if result == nil then return true end
    return result.Instance:IsDescendantOf(char)
end

local function isKnockedOrDead(char)
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    if hum.Health <= 0 then return true end
    if hum.PlatformStand then return true end
    
    pcall(function()
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Physics then 
            return true 
        end
    end)

    if char:FindFirstChild("Ragdoll") or char:FindFirstChild("RagdollTrigger") then return true end
    if char:GetAttribute("Ragdoll") == true or char:GetAttribute("Downed") == true or char:GetAttribute("Knocked") == true then return true end
    
    for _,attr in ipairs({"Knocked","knocked","IsKnocked","Downed","downed","IsDown","Eliminated","Dead","IsDead","Revivable","IsRevivable","IsKO","KO","Killed","IsKilled"}) do
        if char:GetAttribute(attr) == true then return true end
    end

    for _,plr in ipairs(PLRS:GetPlayers()) do
        if plr.Character == char then
            for _,attr in ipairs({"Downed","Knocked","Killed","KO"}) do
                if plr:GetAttribute(attr) == true then return true end
            end
            break
        end
    end
    return false
end

local function w2v(pos)
    local s,on=Camera:WorldToViewportPoint(pos)
    return Vector2.new(s.X,s.Y),on,s.Z
end

local function getVelocity(part)
    local v=Vector3.zero
    pcall(function() v=part.AssemblyLinearVelocity~=nil and part.AssemblyLinearVelocity or part.Velocity end)
    return v or Vector3.zero
end

local function predictPos(part,scale,spd)
    local dist=(part.Position-Camera.CFrame.Position).Magnitude
    local t=dist/math.max(spd or C.aaBulletSpd,10)
    return part.Position + getVelocity(part)*t*(scale or C.aaPredScale)
end

local function isMelee(tool)
    if not tool then return false end
    local n=tool.Name:lower()
    for _,p in ipairs({"knife","blade","melee","fist","bat","sword","machete","punch","dagger","axe"}) do
        if n:find(p) then return true end
    end
    return false
end

local function isWhitelisted(p)
    if not p then return false end
    return C.whitelist[tostring(p.UserId)] ~= nil or C.whitelist[p.Name] ~= nil
end

local function isBlacklisted(p)
    if not p then return false end
    return C.blacklist[tostring(p.UserId)] ~= nil or C.blacklist[p.Name] ~= nil
end

