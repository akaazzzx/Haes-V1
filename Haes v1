        row.Size=UDim2.new(1,-4,0,22) row.BackgroundColor3=BG4 row.BorderSizePixel=0 row.ZIndex=4
        Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
        local txt = Instance.new("TextLabel", row)
        txt.Size=UDim2.new(1,-24,1,0) txt.Position=UDim2.new(0,8,0,0)
        txt.BackgroundTransparency=1 txt.Text="  "..tostring(name) txt.TextColor3=Color3.fromRGB(255,60,60)
        txt.Font=Enum.Font.GothamSemibold txt.TextSize=10 txt.TextXAlignment=Enum.TextXAlignment.Left txt.ZIndex=5
        local rem = Instance.new("TextButton", row)
        rem.Size=UDim2.new(0,20,0,17) rem.Position=UDim2.new(1,-22,0.5,-8.5)
