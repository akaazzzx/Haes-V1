    local fill=Instance.new("Frame",trkBg)
    fill.Size=UDim2.new(math.clamp((init-mn)/(mx-mn),0,1),0,1,0)
    fill.BackgroundColor3=ACC() fill.BorderSizePixel=0 fill.ZIndex=5
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0) regT(fill,"BackgroundColor3")
    
    local thumb=Instance.new("Frame",trkBg)
    thumb.Size=UDim2.new(0,11,0,11) thumb.AnchorPoint=Vector2.new(0.5,0.5)
    thumb.Position=UDim2.new(math.clamp((init-mn)/(mx-mn),0,1),0,0.5,0)
    thumb.BackgroundColor3=Color3.new(1,1,1) thumb.BorderSizePixel=0 thumb.ZIndex=6
    Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)
    local tS=Instance.new("UIStroke",thumb) tS.Color=ACC() tS.Thickness=1 tS.Transparency=0 regT(tS,"Color")

    local trackBtn=Instance.new("TextButton",row)
    trackBtn.Size=UDim2.new(1,-16,0,20) trackBtn.Position=UDim2.new(0,8,0,28)
    trackBtn.BackgroundTransparency=1 trackBtn.Text="" trackBtn.ZIndex=7 trackBtn.AutoButtonColor=false

    local isF=fmt~=nil
    local function clampVal(val)
        return isF and(math.floor(math.clamp(val,mn,mx)*100+0.5)/100) or math.floor(math.clamp(val,mn,mx)+0.5)
    end
    local function applyVal(val)
        val=clampVal(val)
        local pct=math.clamp((val-mn)/(mx-mn),0,1)
        fill.Size=UDim2.new(pct,0,1,0) thumb.Position=UDim2.new(pct,0,0.5,0)
        inputBox.Text=fmt and string.format(fmt,val) or tostring(val)
        pcall(cb,val)
    end
    if configKey then
        UI_Update[configKey] = function(v) applyVal(v) end
    end
    local function applyFromMouse(sx)
        local sz=trackBtn.AbsoluteSize.X
        if sz<=0 then return end
        local pct=math.clamp((sx-trackBtn.AbsolutePosition.X)/sz,0,1)
        applyVal(mn+(mx-mn)*pct)
    end

    inputBox.Focused:Connect(function() inputStroke.Color=ACC() inputBox.BackgroundColor3=BG3 end)
    inputBox.FocusLost:Connect(function()
        inputStroke.Color=BORDER inputBox.BackgroundColor3=BG4
        local num=tonumber(inputBox.Text)
        if num then applyVal(num)
        else applyVal(clampVal(init)) end
    end)

    trackBtn.MouseButton1Down:Connect(function()
        applyFromMouse(Mouse.X)
        local dragging=true
        local c1,c2
        c1=UIS.InputChanged:Connect(function(inp)
            if not dragging then return end
            if inp.UserInputType==Enum.UserInputType.MouseMovement then
                applyFromMouse(inp.Position.X)
            end
        end)
        c2=UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                dragging=false
                if c1 then c1:Disconnect() end
                if c2 then c2:Disconnect() end
            end
        end)
    end)

    row.MouseEnter:Connect(function() row.BackgroundColor3=BG4 thumb.Size=UDim2.new(0,13,0,13) end)
    row.MouseLeave:Connect(function() row.BackgroundColor3=BG3 thumb.Size=UDim2.new(0,11,0,11) end)
end

