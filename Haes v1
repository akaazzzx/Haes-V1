local dragOn,dragStart,dragOrig=false,nil,nil
topBar.InputBegan:Connect(function(i)
    if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    dragOn=true dragStart=i.Position dragOrig=main.Position
end)
UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragOn=false end end)
UIS.InputChanged:Connect(function(i)
    if not(dragOn and dragStart and i.UserInputType==Enum.UserInputType.MouseMovement) then return end
    local d=i.Position-dragStart
    main.Position=UDim2.new(dragOrig.X.Scale,dragOrig.X.Offset+d.X,dragOrig.Y.Scale,dragOrig.Y.Offset+d.Y)
end)

UIS.InputBegan:Connect(function(input)
    if input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    local mp=input.Position
    local function inside(f)
        if not f.Visible then return false end
        local ap=f.AbsolutePosition local as=f.AbsoluteSize
        return mp.X>=ap.X and mp.X<=ap.X+as.X and mp.Y>=ap.Y and mp.Y<=ap.Y+as.Y
    end
    if not inside(ddFrame) and(not curDDBtn or not inside(curDDBtn)) then closeDD() end
    if not inside(modeFrame) then closeModeMenu() end
end)

UIS.InputBegan:Connect(function(input,gpe)
    if bindListening then
        local bnd=nil
        if input.UserInputType==Enum.UserInputType.Keyboard then
            local kn=input.KeyCode.Name
            if kn~="Unknown" and kn~=C.menuKey then bnd={type="key",value=kn} end
        elseif input.UserInputType==Enum.UserInputType.MouseButton1 and not gpe then
            bnd={type="mouse",value="Button1"}
        elseif input.UserInputType==Enum.UserInputType.MouseButton2 and not gpe then
            bnd={type="mouse",value="Button2"}
        end
        
        if bindListening == "menuKey" then
            if input.UserInputType==Enum.UserInputType.Keyboard then
                local kn = input.KeyCode.Name
                if kn ~= "Unknown" then
                    C.menuKey = kn
                    if UI_Update["menuKey"] then UI_Update["menuKey"](kn) end
                    bindListening = nil
                end
            end
            return
        end
        
        if bnd then
            if not C.binds[bindListening] then C.binds[bindListening]={mode="Toggle"} end
            C.binds[bindListening].key=bnd
            if bindCallbacks[bindListening] then bindCallbacks[bindListening]() end
            bindListening=nil
        end
        return
    end
    if input.UserInputType==Enum.UserInputType.Keyboard and not gpe
        and not UIS:GetFocusedTextBox()
        and input.KeyCode==Enum.KeyCode[C.menuKey] then
        main.Visible=not main.Visible return
    end
    if gpe or UIS:GetFocusedTextBox() then return end
    for _,feat in ipairs({"aa","tb","esp"}) do
        if keyMatch(C.binds[feat],input) then onKeyDown(feat) end
    end
end)
UIS.InputEnded:Connect(function(input)
    for _,feat in ipairs({"aa","tb","esp"}) do
        if keyMatch(C.binds[feat],input) then onKeyUp(feat) end
    end
end)

