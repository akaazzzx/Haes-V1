                    for k,v in pairs(c) do
                        if type(C[k]) == "number" or type(C[k]) == "boolean" or type(C[k]) == "string" then C[k] = v end
                    end
                    if c.accent then 
                        C.accent = Color3.new(c.accent[1], c.accent[2], c.accent[3])
                        applyTheme()
                        local bestName = "Purple"
                        local minDist = math.huge
                        local map={
                            Purple=Color3.fromRGB(124,58,237),Pink=Color3.fromRGB(236,72,153),
                            Cyan=Color3.fromRGB(0,210,255),Red=Color3.fromRGB(255,55,55),
                            Green=Color3.fromRGB(55,255,120),Orange=Color3.fromRGB(255,140,30),
                            White=Color3.fromRGB(240,240,240),
                        }
                        for nm, col in pairs(map) do
                            local d = (col.R-C.accent.R)^2 + (col.G-C.accent.G)^2 + (col.B-C.accent.B)^2
                            if d < minDist then minDist = d; bestName = nm end
                        end
                        if accentDropdownSel then accentDropdownSel.Text = bestName end
                    end
                    if c.aaFovCol then 
                        C.aaFovCol = Color3.new(c.aaFovCol[1], c.aaFovCol[2], c.aaFovCol[3])
                        local bestName = "Purple"
                        local minDist = math.huge
                        local map={
                            Purple=Color3.fromRGB(124,58,237),Pink=Color3.fromRGB(236,72,153),
                            Cyan=Color3.fromRGB(0,210,255),Red=Color3.fromRGB(255,55,55),
                            Green=Color3.fromRGB(55,255,120),Orange=Color3.fromRGB(255,140,30),
                            White=Color3.fromRGB(255,255,255),
                        }
                        for nm, col in pairs(map) do
                            local d = (col.R-C.aaFovCol.R)^2 + (col.G-C.aaFovCol.G)^2 + (col.B-C.aaFovCol.B)^2
                            if d < minDist then minDist = d; bestName = nm end
                        end
                        if fovColorDropdownSel then fovColorDropdownSel.Text = bestName end
                    end
                    if c.whitelist then 
                        C.whitelist = {} 
                        for wk, wv in pairs(c.whitelist) do C.whitelist[wk] = wv end 
                    end
                    if c.blacklist then 
                        C.blacklist = {} 
                        for bk, bv in pairs(c.blacklist) do C.blacklist[bk] = bv end 
                    end
                    if c._state then for k,v in pairs(c._state) do C._state[k] = v end end
                    
                    if c.binds then
                        C.binds = {}
                        for bk, bv in pairs(c.binds) do
                            C.binds[bk] = {}
                            for bsk, bsv in pairs(bv) do C.binds[bk][bsk] = bsv end
                        end
                    end
                    if c.menuKey then C.menuKey = c.menuKey end
                    
                    for key, updater in pairs(UI_Update) do
                        if key:find("_state_") then
                            local stKey = key:gsub("_state_", "")
                            updater(C._state[stKey])
                        elseif C[key] ~= nil then
                            updater(C[key])
                        end
                    end
                    for feat, u in pairs(toggleUpdaters) do u() end
                    for feat, cb in pairs(bindCallbacks) do cb() end
                    updatePlayerUI()
                    showNotif("Loaded config: "..name, Color3.fromRGB(50,200,100))
                end
            end)
            
            delBtn.MouseButton1Click:Connect(function()
                Configs[name] = nil
                writeJson(CONFIG_FILE, Configs)
                refreshConfigUI()
                showNotif("Deleted config: "..name, Color3.fromRGB(220,60,60))
            end)

            renBtn.MouseButton1Click:Connect(function()
                currentRenameTarget = name
                rmInput.Text = name
                renameModal.Visible = true
            end)
        end
    end
end

