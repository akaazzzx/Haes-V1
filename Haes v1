--  AIM ASSIST & TRIGGERBOT
-- ═══════════════════════════════════════════════════════════
local fovCircle=nil
local stickyTarget=nil

local function smoothCF(currentCF, targetPos, smoothness, dt, mode)
    local goalCF = CFrame.lookAt(currentCF.Position, targetPos)
    local speed = 30 / math.max(smoothness, 0.5)
    local alpha = 1 - math.exp(-speed * dt)
    alpha = math.clamp(alpha, 0.01, 0.5)
    if mode == "Quadratic" then alpha = 1 - (1 - alpha)^2
    elseif mode == "Sine" then alpha = math.sin(alpha * math.pi / 2) end
    alpha = math.clamp(alpha, 0.01, 0.6)
    return currentCF:Lerp(goalCF, alpha)
end

local function springCF(currentCF, targetPos, smoothness, dt)
    local goalCF = CFrame.lookAt(currentCF.Position, targetPos)
    local curLook = currentCF.LookVector
    local goalLook = goalCF.LookVector
    local dot = math.clamp(curLook:Dot(goalLook), -1, 1)
    if dot > 0.99995 then C._springV=0 return currentCF end
    local angle = math.acos(dot)
    local axis = curLook:Cross(goalLook)
    if axis.Magnitude < 1e-6 then C._springV=0 return currentCF end
    axis = axis.Unit
    local stiffness = math.clamp(200 / math.max(smoothness, 0.5), 8, 300)
    local damping = 2 * math.sqrt(stiffness) * 0.9
    local force = angle * stiffness - C._springV * damping
    C._springV = C._springV + force * dt
    local step = C._springV * dt
    if math.abs(step) > angle then
        step = angle * (step > 0 and 1 or -1)
        C._springV = 0
    end
    local rot = CFrame.fromAxisAngle(axis, step)
    local rotPart = currentCF - currentCF.Position
    return CFrame.new(currentCF.Position) * (rot * rotPart)
end

local function tickAimAssist(dt)
    if fovCircle then
        fovCircle.Visible = C._state.aa and C.aaFovShow
        if fovCircle.Visible then
            fovCircle.Position=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
            fovCircle.Radius=C.aaFov fovCircle.Color=C.aaFovCol
        end
    end
    if not isActive("aa") then 
        C._springV = 0 
        stickyTarget = nil
        return 
    end
    
    local t = nil
    if C.aaSticky and stickyTarget then
        local ch = stickyTarget.Character
        if ch and not isKnockedOrDead(ch) and ch:FindFirstChild(C.aaPart) then
            t = {plr = stickyTarget, part = ch:FindFirstChild(C.aaPart)}
        else
            stickyTarget = nil
        end
    end
    
    if not t then
        t = getTarget(C.aaTeam,C.aaWall,C.aaHp,C.aaKnock,C.aaPart,C.aaDist,C.aaFov)
        if t and C.aaSticky then stickyTarget = t.plr end
    end
    
    if not t then C._springV=0 return end
    
    local aimPos = C.aaPred and predictPos(t.part, C.aaPredScale, C.aaBulletSpd) or t.part.Position
    local newCF
    if C.aaSmoothMode == "Spring" then
        newCF = springCF(Camera.CFrame, aimPos, C.aaSmooth, dt)
    else
        newCF = smoothCF(Camera.CFrame, aimPos, C.aaSmooth, dt, C.aaSmoothMode)
    end
    if newCF then Camera.CFrame = newCF end
end

