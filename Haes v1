local function hideESP(obj)
    for _,v in pairs(obj) do
        if type(v)=="table" then for _,l in ipairs(v) do pcall(function() l.Visible=false end) end
        else pcall(function() v.Visible=false end) end
    end
end
local SKEL_PAIRS={
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"},{"UpperTorso","LeftUpperArm"},
    {"LowerTorso","RightUpperLeg"},{"LowerTorso","LeftUpperLeg"},
}
local function cornersOf(tl,tr,bl,br)
    local W=tr.X-tl.X local H=bl.Y-tl.Y local f=0.26
    return{
        {tl,tl+Vector2.new(W*f,0)},{tl,tl+Vector2.new(0,H*f)},
        {tr,tr+Vector2.new(-W*f,0)},{tr,tr+Vector2.new(0,H*f)},
        {bl,bl+Vector2.new(W*f,0)},{bl,bl+Vector2.new(0,-H*f)},
        {br,br+Vector2.new(-W*f,0)},{br,br+Vector2.new(0,-H*f)},
    }
end
local function tickESP()
    for pl,obj in pairs(ESPObjs) do
        if not isActive("esp") then hideESP(obj) continue end
        local ch=pl.Character
        if not ch then hideESP(obj) continue end
        local hum=ch:FindFirstChildOfClass("Humanoid")
        local root=ch:FindFirstChild("HumanoidRootPart")
        local head=ch:FindFirstChild("Head")
        if not hum or not root then hideESP(obj) continue end
        if not C.espSelf and pl==LP then hideESP(obj) continue end
        if isWhitelisted(pl) then hideESP(obj) continue end
        
        local isBl = isBlacklisted(pl)
        if C.espTeam and isTeam(pl) and not isBl then hideESP(obj) continue end
        if hum.Health<=0 then hideESP(obj) continue end
        
        local camDist=(root.Position-Camera.CFrame.Position).Magnitude
        if camDist>C.espDist then hideESP(obj) continue end
        if C.espWall and head and not rayWall(ch,head) then hideESP(obj) continue end
        
        local sz=root.Size
        local offs={
            Vector3.new(-sz.X,-sz.Y*2.2,sz.Z),Vector3.new(sz.X,-sz.Y*2.2,sz.Z),
            Vector3.new(-sz.X,sz.Y*1.6,sz.Z),Vector3.new(sz.X,sz.Y*1.6,sz.Z),
            Vector3.new(-sz.X,-sz.Y*2.2,-sz.Z),Vector3.new(sz.X,-sz.Y*2.2,-sz.Z),
            Vector3.new(-sz.X,sz.Y*1.6,-sz.Z),Vector3.new(sz.X,sz.Y*1.6,-sz.Z),
        }
        local mnX,mnY,mxX,mxY=math.huge,math.huge,-math.huge,-math.huge
        local anyOn=false
        for _,off in ipairs(offs) do
            local s,on2=w2v((root.CFrame*CFrame.new(off)).Position)
            if on2 then anyOn=true end
            if s.X<mnX then mnX=s.X end if s.Y<mnY then mnY=s.Y end
            if s.X>mxX then mxX=s.X end if s.Y>mxY then mxY=s.Y end
        end
        if not anyOn then hideESP(obj) continue end
        local tl=Vector2.new(mnX,mnY) local tr=Vector2.new(mxX,mnY)
        local bl=Vector2.new(mnX,mxY) local br=Vector2.new(mxX,mxY)
        local col=C.espTeamCol
            and(isTeam(pl) and Color3.fromRGB(0,210,75) or Color3.fromRGB(124,58,237))
            or Color3.fromRGB(255,255,255)
        if isBl then col = Color3.fromRGB(255, 60, 60) end
        
        if C.boxOn then
            local segs=C.boxType=="Corners" and cornersOf(tl,tr,bl,br)
                or{{tl,tr},{tr,br},{br,bl},{bl,tl},{tl,tl},{tl,tl},{tl,tl},{tl,tl}}
            for i=1,8 do
                if C.boxType=="Full" and i>4 then obj.box[i].Visible=false
                else obj.box[i].From=segs[i][1] obj.box[i].To=segs[i][2]
                     obj.box[i].Color=col obj.box[i].Visible=true end
            end
        else for i=1,8 do obj.box[i].Visible=false end end
        if C.espHpBar then
            local hp=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            local bH=mxY-mnY local bx=mnX-6
            obj.hpBg.From=Vector2.new(bx,mnY) obj.hpBg.To=Vector2.new(bx,mxY) obj.hpBg.Visible=true
            obj.hp.From=Vector2.new(bx,mxY) obj.hp.To=Vector2.new(bx,mxY-bH*hp)
            obj.hp.Color=Color3.fromRGB(math.floor((1-hp)*255),math.floor(hp*220),40) obj.hp.Visible=true
        else obj.hpBg.Visible=false obj.hp.Visible=false end
        if C.nameOn then
            obj.name.Text=C.nameType=="Display Name" and(pl.DisplayName or pl.Name) or pl.Name
            obj.name.Position=Vector2.new((mnX+mxX)/2,mnY-16) obj.name.Color=col obj.name.Visible=true
        else obj.name.Visible=false end
        if C.showDist then
            obj.dist.Text=string.format("[%.0f]",camDist)
            obj.dist.Position=Vector2.new((mnX+mxX)/2,mxY+3) obj.dist.Visible=true
        else obj.dist.Visible=false end
        if C.showDot and head then
            local hs,hon=w2v(head.Position) obj.hdot.Position=hs obj.hdot.Visible=hon
        else obj.hdot.Visible=false end
        if C.tracerOn then
            local from
            if C.tracerOrig=="Top" then from=Vector2.new(Camera.ViewportSize.X/2,0)
            elseif C.tracerOrig=="Middle" then from=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
            elseif C.tracerOrig=="Mouse" then from=Vector2.new(Mouse.X,Mouse.Y)
            else from=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y) end
            obj.tracer.From=from obj.tracer.To=Vector2.new((mnX+mxX)/2,(mnY+mxY)/2)
            obj.tracer.Color=col obj.tracer.Visible=true
        else obj.tracer.Visible=false end
        if C.showSkel then
            for i,pair in ipairs(SKEL_PAIRS) do
                local pA=ch:FindFirstChild(pair[1]) local pB=ch:FindFirstChild(pair[2])
                if pA and pB then
                    local sA,onA=w2v(pA.Position) local sB,onB=w2v(pB.Position)
                    if onA or onB then
                        obj.skel[i].From=sA obj.skel[i].To=sB obj.skel[i].Color=col obj.skel[i].Visible=true
                    else obj.skel[i].Visible=false end
                else obj.skel[i].Visible=false end
            end
        else for i=1,6 do obj.skel[i].Visible=false end end
    end
end

