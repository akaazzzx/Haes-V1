local holdState={aa=false,tb=false,esp=false}
local toggleUpdaters={}
local function keyMatch(bind,input)
    if not bind or not bind.key then return false end
    local k=bind.key
    if k.type=="key" then return input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode.Name==k.value end
    if k.type=="mouse" then
        if k.value=="Button1" then return input.UserInputType==Enum.UserInputType.MouseButton1 end
        if k.value=="Button2" then return input.UserInputType==Enum.UserInputType.MouseButton2 end
    end
    return false
end

local function isActive(feat)
    if not C._state[feat] then return false end
    local b=C.binds[feat] local mode=b and(b.mode or "Toggle") or "Toggle"
    if mode=="Always" then return true end
    if mode=="Hold" then return holdState[feat] end
    return true
end

local function onKeyDown(feat)
    local b=C.binds[feat] if not b then return end
    local mode=b.mode or "Toggle"
    if mode=="Toggle" then
        C._state[feat]=not C._state[feat]
        local u=toggleUpdaters[feat] if u then u() end
    elseif mode=="Hold" then holdState[feat]=true
    elseif mode=="Click" then
        C._state[feat]=true
        task.delay(0.05,function() C._state[feat]=false end)
    end
end
local function onKeyUp(feat)
    local b=C.binds[feat] if not b then return end
    if(b.mode or "Toggle")=="Hold" then holdState[feat]=false end
end

